{
  "name": "skillwarden",
  "version": "0.1.0",
  "description": "npm audit for agent skills: pin, verify, and audit-gate the skills your coding agents execute",
  "keywords": [
    "agent-skills",
    "claude-code",
    "supply-chain-security",
    "skills",
    "cli"
  ],
  "license": "MIT",
  "author": "Colton Bearden <inbox@coltonbearden.com> (https://coltonbearden.com)",
  "type": "module",
  "bin": {
    "skillwarden": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --test tests/integration/smoke.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FirstCastSolutions423/skillwarden.git"
  },
  "bugs": {
    "url": "https://github.com/FirstCastSolutions423/skillwarden/issues"
  },
  "homepage": "https://github.com/FirstCastSolutions423/skillwarden#readme"
}
